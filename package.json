{
  "name": "jj2mp-api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "esbuild examples/examples.ts --bundle --platform=node --format=esm --outfile=dist/examples.mjs && node dist/examples.mjs",
